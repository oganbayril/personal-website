# Copy to deploy.env (git-ignored) and fill in. Read by deploy.sh.
# Plain KEY=value lines; nothing here is executed.

# Server hostname or IP address
DEPLOY_HOST=

# SSH user on the server (key-based login; deploy.sh uses BatchMode)
DEPLOY_USER=

# Optional: absolute path of the deploy-only checkout on the server.
# Empty = ~/src/personal-website in DEPLOY_USER's home.
DEPLOY_CHECKOUT=
